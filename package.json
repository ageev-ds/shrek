{
  "name": "shrek-jeopardy",
  "productName": "Своя игра Шрек",
  "version": "1.0.0",
  "description": "Своя игра по вселенной Шрека — викторина ко дню рождения",
  "author": "ageev-ds",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.cjs",
  "type": "module",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.5",
    "howler": "^2.2.4",
    "immer": "^11.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "wait-on": "^9.4.0"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,main,app \"vite\" \"node scripts/build-electron.mjs --watch\" \"wait-on tcp:5173 dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "node scripts/build-electron.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "content": "node scripts/build-default-game.mjs",
    "check": "tsc --noEmit && node scripts/validate-game.mjs",
    "icon": "node scripts/make-icon.mjs",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "build:win": "npm run check && npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux dir"
  }
}
